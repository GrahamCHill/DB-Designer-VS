{
  "name": "db-designer-vs",
  "displayName": "DB Designer VS",
  "description": "Database designer for VS Code: interactive, editable ER diagrams from SQL files or a live database (PostgreSQL, SQL Server, MySQL, SQLite). Validated SQL export to PostgreSQL, SQL Server, MySQL or SQLite, table groups, high-res images, shareable diagrams and AI normalisation reviews.",
  "version": "0.5.1",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other",
    "AI"
  ],
  "keywords": [
    "erd",
    "er diagram",
    "sql",
    "postgres",
    "schema",
    "normalization",
    "database",
    "diagram"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "dbDesigner.openFromSqlFolder",
        "title": "Open ERD from SQL Folder…",
        "category": "DB Designer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "dbDesigner.openFromSqlFiles",
        "title": "Open ERD from SQL Files…",
        "category": "DB Designer",
        "icon": "$(file-code)"
      },
      {
        "command": "dbDesigner.openFromDatabase",
        "title": "Open ERD from Database Connection…",
        "category": "DB Designer",
        "icon": "$(database)"
      },
      {
        "command": "dbDesigner.openErdFile",
        "title": "Open Shared Diagram (.erd.json)…",
        "category": "DB Designer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "dbDesigner.manageConnections",
        "title": "Remove Saved Connection…",
        "category": "DB Designer"
      },
      {
        "command": "dbDesigner.openFromExplorer",
        "title": "Open ERD",
        "category": "DB Designer"
      },
      {
        "command": "dbDesigner.newBlank",
        "title": "New Blank ERD",
        "category": "DB Designer",
        "icon": "$(new-file)"
      },
      {
        "command": "dbDesigner.aiReview",
        "title": "AI: Review Normalisation of Open Diagram",
        "category": "DB Designer"
      },
      {
        "command": "dbDesigner.aiChooseProvider",
        "title": "AI: Choose Provider…",
        "category": "DB Designer"
      },
      {
        "command": "dbDesigner.aiChooseModel",
        "title": "AI: Choose Model…",
        "category": "DB Designer"
      },
      {
        "command": "dbDesigner.refreshSidebar",
        "title": "Refresh",
        "category": "DB Designer",
        "icon": "$(refresh)"
      },
      {
        "command": "dbDesigner.revealDiagram",
        "title": "Show Diagram",
        "category": "DB Designer"
      },
      {
        "command": "dbDesigner.openRecent",
        "title": "Open Diagram",
        "category": "DB Designer"
      },
      {
        "command": "dbDesigner.removeRecent",
        "title": "Remove from Recent",
        "category": "DB Designer",
        "icon": "$(close)"
      },
      {
        "command": "dbDesigner.clearRecent",
        "title": "Clear Recent Diagrams",
        "category": "DB Designer",
        "icon": "$(clear-all)"
      },
      {
        "command": "dbDesigner.openConnection",
        "title": "Open ERD",
        "category": "DB Designer",
        "icon": "$(play)"
      },
      {
        "command": "dbDesigner.removeConnectionItem",
        "title": "Remove Connection",
        "category": "DB Designer",
        "icon": "$(trash)"
      },
      {
        "command": "dbDesigner.aiSetApiKey",
        "title": "AI: Set API Key (stored encrypted)…",
        "category": "DB Designer"
      },
      {
        "command": "dbDesigner.aiClearApiKeys",
        "title": "AI: Remove Saved API Keys…",
        "category": "DB Designer"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "dbDesigner.openFromExplorer",
          "when": "explorerResourceIsFolder || resourceExtname == .sql || resourceFilename =~ /.erd.json$/",
          "group": "navigation@90"
        }
      ],
      "commandPalette": [
        {
          "command": "dbDesigner.revealDiagram",
          "when": "false"
        },
        {
          "command": "dbDesigner.openRecent",
          "when": "false"
        },
        {
          "command": "dbDesigner.removeRecent",
          "when": "false"
        },
        {
          "command": "dbDesigner.openConnection",
          "when": "false"
        },
        {
          "command": "dbDesigner.removeConnectionItem",
          "when": "false"
        },
        {
          "command": "dbDesigner.openFromExplorer",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "dbDesigner.openFromSqlFolder",
          "when": "view == dbDesigner.diagrams",
          "group": "navigation@1"
        },
        {
          "command": "dbDesigner.openFromDatabase",
          "when": "view == dbDesigner.diagrams",
          "group": "navigation@2"
        },
        {
          "command": "dbDesigner.newBlank",
          "when": "view == dbDesigner.diagrams",
          "group": "navigation@3"
        },
        {
          "command": "dbDesigner.openErdFile",
          "when": "view == dbDesigner.diagrams",
          "group": "1_more@1"
        },
        {
          "command": "dbDesigner.openFromSqlFiles",
          "when": "view == dbDesigner.diagrams",
          "group": "1_more@2"
        },
        {
          "command": "dbDesigner.clearRecent",
          "when": "view == dbDesigner.diagrams",
          "group": "2_clear"
        },
        {
          "command": "dbDesigner.openFromDatabase",
          "when": "view == dbDesigner.connections",
          "group": "navigation@1"
        },
        {
          "command": "dbDesigner.refreshSidebar",
          "when": "view == dbDesigner.connections || view == dbDesigner.sqlFolders",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "dbDesigner.openConnection",
          "when": "view == dbDesigner.connections && viewItem == connection",
          "group": "inline@1"
        },
        {
          "command": "dbDesigner.removeConnectionItem",
          "when": "view == dbDesigner.connections && viewItem == connection",
          "group": "inline@2"
        },
        {
          "command": "dbDesigner.removeConnectionItem",
          "when": "view == dbDesigner.connections && viewItem == connection",
          "group": "9_remove"
        },
        {
          "command": "dbDesigner.removeRecent",
          "when": "view == dbDesigner.diagrams && viewItem == recentDiagram",
          "group": "inline"
        },
        {
          "command": "dbDesigner.clearRecent",
          "when": "view == dbDesigner.diagrams && viewItem == group-recent",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "DB Designer VS",
      "properties": {
        "dbDesigner.excludeFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".git",
            ".agents",
            "dist",
            "build",
            "out"
          ],
          "description": "Folder names skipped when collecting .sql files recursively. Folders starting with '.' are always skipped."
        },
        "dbDesigner.ai.provider": {
          "type": "string",
          "enum": [
            "vscode",
            "anthropic",
            "openai",
            "ollama"
          ],
          "default": "vscode",
          "enumDescriptions": [
            "A chat model available in VS Code (GitHub Copilot or another installed provider). No API key needed.",
            "Anthropic Claude API. The key is stored encrypted in VS Code Secret Storage.",
            "Groq, OpenAI, OpenRouter, LM Studio or any OpenAI-compatible endpoint (see dbDesigner.ai.openaiBaseUrl). The key is stored encrypted in VS Code Secret Storage.",
            "A local Ollama server, so the schema never leaves your machine."
          ],
          "description": "Which language model the AI normalisation review uses. Only the schema (tables, columns, keys) is sent, never row data."
        },
        "dbDesigner.ai.vscodeModel": {
          "type": "string",
          "default": "",
          "description": "Model ID or family for the VS Code provider. Empty = choose from available models on first use."
        },
        "dbDesigner.ai.anthropicModel": {
          "type": "string",
          "default": "claude-opus-5-5",
          "description": "Claude model id for the Anthropic provider."
        },
        "dbDesigner.ai.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL of the Ollama server."
        },
        "dbDesigner.ai.ollamaModel": {
          "type": "string",
          "default": "",
          "description": "Ollama model name (e.g. \"qwen2.5-coder:14b\"). Empty = choose from installed models the first time."
        },
        "dbDesigner.ai.openaiBaseUrl": {
          "type": "string",
          "default": "https://api.groq.com/openai/v1",
          "description": "Base URL of the OpenAI-compatible API (Groq by default). Examples: https://api.openai.com/v1, https://openrouter.ai/api/v1, http://localhost:1234/v1 (LM Studio)."
        },
        "dbDesigner.ai.openaiModel": {
          "type": "string",
          "default": "",
          "description": "Model ID for the OpenAI-compatible provider. Empty = choose from models available at the configured endpoint."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "dbDesigner.erdFile",
        "displayName": "DB Designer",
        "selector": [
          {
            "filenamePattern": "*.erd.json"
          }
        ],
        "priority": "default"
      }
    ],
    "languageModelTools": [
      {
        "name": "db-designer_getSchema",
        "displayName": "Get ERD diagram schema",
        "toolReferenceName": "dbSchema",
        "canBeReferencedInPrompt": true,
        "icon": "$(type-hierarchy)",
        "userDescription": "Read the tables, columns and foreign keys of the ERD diagram that is open in DB Designer.",
        "modelDescription": "Returns the schema of the ER diagram currently open in the DB Designer extension (including unsaved edits), as PostgreSQL DDL (default) or compact JSON. Use it before reviewing or changing the database design, e.g. for normalisation advice.",
        "tags": [
          "database",
          "erd",
          "schema"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "enum": [
                "ddl",
                "json"
              ],
              "description": "Output format. Default ddl."
            }
          }
        }
      },
      {
        "name": "db-designer_applyChanges",
        "displayName": "Apply changes to ERD diagram",
        "toolReferenceName": "dbApply",
        "canBeReferencedInPrompt": true,
        "icon": "$(edit)",
        "userDescription": "Apply schema changes (add/split tables, columns, keys, foreign keys) to the open ERD diagram as an undoable draft.",
        "modelDescription": "Applies a list of schema operations to the ER diagram open in DB Designer, as one undoable draft edit that the user confirms. Call db-designer_getSchema first and use exact, schema-qualified table names. Operations: add_table (table, column_defs), drop_table, rename_table (new_name), add_column (table, column_defs with one entry), drop_column (column), rename_column (column, new_name), alter_column (column + type/nullable/unique/default), set_primary_key (columns), add_foreign_key (columns, ref_table, ref_columns, on_delete), drop_foreign_key (columns). The user can afterwards export the result as a PostgreSQL migration.",
        "tags": [
          "database",
          "erd",
          "schema"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "operations"
          ],
          "properties": {
            "description": {
              "type": "string",
              "description": "One sentence explaining why these changes are made (shown to the user)."
            },
            "operations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "table"
                ],
                "properties": {
                  "op": {
                    "type": "string",
                    "enum": [
                      "add_table",
                      "drop_table",
                      "rename_table",
                      "add_column",
                      "drop_column",
                      "rename_column",
                      "alter_column",
                      "set_primary_key",
                      "add_foreign_key",
                      "drop_foreign_key"
                    ]
                  },
                  "table": {
                    "type": "string",
                    "description": "Target table, schema-qualified when not in the default schema (e.g. \"app.users\")."
                  },
                  "column": {
                    "type": "string",
                    "description": "Column name for column-level operations."
                  },
                  "new_name": {
                    "type": "string",
                    "description": "For rename_table / rename_column."
                  },
                  "type": {
                    "type": "string",
                    "description": "Data type for add_column / alter_column."
                  },
                  "nullable": {
                    "type": "boolean"
                  },
                  "unique": {
                    "type": "boolean"
                  },
                  "primary_key": {
                    "type": "boolean"
                  },
                  "default": {
                    "type": "string"
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Column names for set_primary_key / add_foreign_key / drop_foreign_key."
                  },
                  "ref_table": {
                    "type": "string"
                  },
                  "ref_columns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "on_delete": {
                    "type": "string",
                    "enum": [
                      "NO ACTION",
                      "RESTRICT",
                      "CASCADE",
                      "SET NULL",
                      "SET DEFAULT"
                    ]
                  },
                  "column_defs": {
                    "type": "array",
                    "description": "Column definitions for add_table (and add_column, one entry).",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "type"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "nullable": {
                          "type": "boolean"
                        },
                        "primary_key": {
                          "type": "boolean"
                        },
                        "unique": {
                          "type": "boolean"
                        },
                        "default": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "comment": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbDesigner",
          "title": "DB Designer",
          "icon": "media/erd.svg"
        }
      ]
    },
    "views": {
      "dbDesigner": [
        {
          "id": "dbDesigner.diagrams",
          "name": "Diagrams"
        },
        {
          "id": "dbDesigner.connections",
          "name": "Database Connections"
        },
        {
          "id": "dbDesigner.sqlFolders",
          "name": "SQL Folders in Workspace"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dbDesigner.diagrams",
        "contents": "Open an entity-relationship diagram from SQL migration files, a live database, or a shared .erd.json file.\n[$(folder-opened) Open SQL Folder](command:dbDesigner.openFromSqlFolder)\n[$(database) Connect to a Database](command:dbDesigner.openFromDatabase)\n[$(go-to-file) Open Shared Diagram](command:dbDesigner.openErdFile)\n[$(new-file) New Blank Diagram](command:dbDesigner.newBlank)"
      },
      {
        "view": "dbDesigner.connections",
        "contents": "No saved connections yet.\n[$(add) Add Connection](command:dbDesigner.openFromDatabase)\nPostgreSQL, SQL Server, MySQL/MariaDB and SQLite are supported. Connection strings are kept in VS Code Secret Storage."
      },
      {
        "view": "dbDesigner.sqlFolders",
        "contents": "No .sql files found in this workspace.\n[$(folder-opened) Open SQL Folder…](command:dbDesigner.openFromSqlFolder)"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "node esbuild.mjs --tests && node --test \"dist-test/*.test.js\"",
    "smoke": "node esbuild.mjs && node test/activate-smoke.js",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies",
    "test:engines": "esbuild test/dialect-integration.ts --bundle --platform=node --outfile=dist-test/dialect-integration.js --external:pg-native --external:cloudflare:sockets --log-level=warning && node dist-test/dialect-integration.js"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@dagrejs/dagre": "^3.1.3",
    "@electric-sql/pglite": "^0.5.16",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^4.1.1",
    "@xyflow/react": "^12.12.1",
    "esbuild": "^0.28.2",
    "mssql": "^12.7.14",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.16.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GrahamCHill/DB-Designer-VS.git"
  }
}
