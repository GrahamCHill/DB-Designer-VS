{
  "name": "erd-viewer",
  "displayName": "ERD Viewer",
  "description": "Interactive, editable ER diagrams from SQL files or a live database (PostgreSQL, SQL Server, MySQL, SQLite), with PostgreSQL export.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "erd",
    "er diagram",
    "sql",
    "postgres",
    "schema"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "erdViewer.openFromSqlFolder",
        "title": "Open ERD from SQL Folder…",
        "category": "ERD Viewer"
      },
      {
        "command": "erdViewer.openFromSqlFiles",
        "title": "Open ERD from SQL Files…",
        "category": "ERD Viewer"
      },
      {
        "command": "erdViewer.openFromDatabase",
        "title": "Open ERD from Database Connection…",
        "category": "ERD Viewer"
      },
      {
        "command": "erdViewer.manageConnections",
        "title": "Remove Saved Connection…",
        "category": "ERD Viewer"
      },
      {
        "command": "erdViewer.openFromExplorer",
        "title": "Open ERD",
        "category": "ERD Viewer"
      },
      {
        "command": "erdViewer.newBlank",
        "title": "New Blank ERD",
        "category": "ERD Viewer"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "erdViewer.openFromExplorer",
          "when": "explorerResourceIsFolder || resourceExtname == .sql",
          "group": "navigation@90"
        }
      ],
      "commandPalette": [
        {
          "command": "erdViewer.openFromExplorer",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "ERD Viewer",
      "properties": {
        "erdViewer.excludeFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".git",
            ".agents",
            "dist",
            "build",
            "out"
          ],
          "description": "Folder names skipped when collecting .sql files recursively. Folders starting with '.' are always skipped."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "node esbuild.mjs --tests && node --test \"dist-test/*.test.js\"",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@dagrejs/dagre": "^3.1.3",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^4.1.1",
    "@xyflow/react": "^12.12.1",
    "esbuild": "^0.28.2",
    "html-to-image": "^1.11.13",
    "mssql": "^12.7.14",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.16.0",
    "typescript": "^7.0.2"
  }
}
